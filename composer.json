{
  "name": "quicko/clubmanager",
  "type": "typo3-cms-extension",
  "description": "The TYPO3 module for managing clubs, foundations and associations. With Clubmanager, you get the tool to manage the organization AND public relations of your club or association in a cost-saving and effective way.",
  "homepage": "https://quicko.software",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "typo3",
    "club",
    "manager",
    "location",
    "member",
    "membership"
  ],
  "autoload": {
    "psr-4": {
      "Quicko\\Clubmanager\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "clubmanager"
    }
  },
  "require": {
    "typo3/cms-core": "^13.4 || ^14.3",
    "sjbr/static-info-tables": "^13.4 || ^14.3",
    "typo3/cms-install": "^13.4 || ^14.3"
  },
  "suggest": {
    "php": "^8.3",
    "fluidtypo3/vhs": "^7 || ^8",
    "typo3/cms-felogin": "^13.4 || ^14.3",
    "bk2k/bootstrap-package": "^16.0"
  }
}
