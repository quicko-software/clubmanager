plugin.tx_mailjournal {
	settings {
		mailView {
			templateRootPaths {
				20 = EXT:clubmanager/Resources/Private/Templates/Email
				25 = {$plugin.tx_clubmanager.mailView.templateRootPath}
			}

			partialRootPaths {
				20 = EXT:clubmanager/Resources/Private/Partials/Email
				25 = {$plugin.tx_clubmanager.mailView.partialRootPath}
			}

			layoutRootPaths {
				20 = EXT:clubmanager/Resources/Private/Layouts/Email
				25 = {$plugin.tx_clubmanager.mailView.layoutRootPath}
			}
		}
	}
}
